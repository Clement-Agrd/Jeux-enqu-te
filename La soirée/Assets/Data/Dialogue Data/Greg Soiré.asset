  m_Name: "Greg Soir\xE9"
  m_EditorClassIdentifier: Core::Core.DialogueData
  AddRange: 40
  pnj: {fileID: 11400000, guid: 914c17825451fd04c87bacc329c17294, type: 2}
  AddDialogue:
  - expression: 2
    text: "Je suis arriv\xE9 avec les autres. Pendant le d\xEEner, Kenny a commenc\xE9
      \xE0 me provoquer."
    textSpeed: 0.01
  - expression: 4
    text: "J\u2019ai essay\xE9 de l'ignorer,  m\xEAme si j'\xE9tais pas bien. Apr\xE8s
      \xE7a, je suis all\xE9 prendre l\u2019air dans la cuisine, puis je suis rest\xE9
      seul un moment pour me calmer."
    textSpeed: 0.01
