  m_Name: "Iness Soir\xE9"
  m_EditorClassIdentifier: Core::Core.DialogueData
  AddRange: 2
  pnj: {fileID: 11400000, guid: 781d81057231cfa4d9f0d668f5993112, type: 2}
  AddDialogue:
  - expression: 2
    text: "Au d\xE9but  tout allait bien. Jusqu'a ce que je surprene Kenny avec Danielle.
      Je suis sortie, je me suis enferm\xE9e un moment. Apr\xE8s \xE7a\u2026 je ne
      voulais plus le voir."
    textSpeed: 1
  - expression: 4
    text: "On s\u2019est disput\xE9s dans la chambre, violemment. Il a cass\xE9 mon
      t\xE9l\xE9phone."
    textSpeed: 1
  - expression: 1
    text: "Je suis sortie, je me suis enferm\xE9e un moment. Apr\xE8s \xE7a\u2026
      je ne voulais plus le voir."
    textSpeed: 1
