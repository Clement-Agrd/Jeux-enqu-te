  AddDialogue:
  - expression: 5
    text: "Kenny m\u2019a demand\xE9 de le rejoindre \xE0 l\u2019\xE9tage."
    textSpeed: 1
  - expression: 4
    text: "Je savais que j\u2019aurais d\xFB refuser. Iness nous a surpris, tout
      est devenu chaotique."
    textSpeed: 1
  - expression: 1
    text: "Apr\xE8s la dispute, je suis descendue, j\u2019\xE9tais compl\xE8tement
      perdue."
    textSpeed: 1
